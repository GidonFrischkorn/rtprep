# Claude Code. The review rules and the review command under .claude/ are
# shared and committed (see .github/workflows/claude-review.yaml); everything
# else Claude Code writes there stays local. A root CLAUDE.md or
# CLAUDE.local.md is a maintainer's private notes and is never committed.
/CLAUDE.md
/CLAUDE.local.md
!/.claude/
/.claude/*
!/.claude/CLAUDE.md
!/.claude/commands/

# R
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj.user
Rplots.pdf

# Package build artefacts
rtprep_*.tar.gz
rtprep.Rcheck/
src/*.o
src/*.so

# Quarto
/.quarto/
manuscript/*.tex
manuscript/*_files/
manuscript/*.pdf
manuscript/*.docx

# Untracked working material: literature PDFs, run logs, planning notes
local/

# Withheld until the manuscript is published. The tutorial manuscript, the
# frozen simulation design, the study scripts and their helpers are kept out of
# the public repository until the paper is accepted; the files stay on disk and
# are versioned in the author's private copy. Delete this block (and re-add the
# files) on acceptance.
/manuscript/
/DESIGN.md
/scripts/
/functions/

# Fitted objects and simulation results are large and regenerable
output/

# SimDesign drops a hostname-keyed tempfile in the launch directory; a stale
# one from an interrupted run must never be committed
SIMDESIGN-TEMPFILE_*

# macOS
.DS_Store
docs
inst/doc
